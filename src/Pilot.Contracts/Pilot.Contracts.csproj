<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Shared by the AOT-published node and by every client (GUI, TUI, CLI), so the trim/AOT
         analyzers run here too. PilotJsonContext lives in this assembly so the node and its clients
         serialise the SAME contract with the SAME generated metadata. -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Pilot.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Where the socket is and how a client reaches it: the org's shared node pieces. -->
    <ProjectReference Include="..\Node.Lib\Node.Lib.csproj" />
  </ItemGroup>

</Project>
