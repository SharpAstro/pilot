<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pilot-node</AssemblyName>
    <RootNamespace>Pilot.Node</RootNamespace>
    <!-- One native binary per machine. PublishAot also turns on the Request Delegate Generator for the Map* calls
         here and the trim/AOT analyzers, but their IL2xxx/IL3xxx warnings only show on a publish with -r <rid>:
         publish to check an endpoint change, building is not enough. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pilot.Contracts\Pilot.Contracts.csproj" />
    <!-- The lock and Kestrel on the socket: the org's shared node pieces. -->
    <ProjectReference Include="..\Node.Lib.Hosting\Node.Lib.Hosting.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!--
    LAN.Lib (discovery, invites, grants) from the sibling clone when it is there, as the GUI takes DIR.Lib: see the
    GUI's project for SharpAstroRoot's two probes and why a publish with a runtime identifier takes the package.
  -->
  <PropertyGroup>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\LAN.Lib')">$(MSBuildThisFileDirectory)..\..\..\</SharpAstroRoot>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\..\LAN.Lib')">$(MSBuildThisFileDirectory)..\..\..\..\..\..\</SharpAstroRoot>
    <UseLocalLanLib Condition="'$(UseLocalLanLib)' == '' AND '$(RuntimeIdentifier)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)LAN.Lib\src\LAN.Lib\LAN.Lib.csproj')">true</UseLocalLanLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalLanLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)LAN.Lib\src\LAN.Lib\LAN.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLanLib)' != 'true'">
    <PackageReference Include="LAN.Lib" />
  </ItemGroup>

  <!-- Written global::, so Node.Lib never resolves as Pilot.Node.Lib inside this namespace. -->
  <ItemGroup>
    <Using Include="Node.Lib" />
    <Using Include="Node.Lib.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pilot.Node.Tests" />
  </ItemGroup>

</Project>
