<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pilot-node</AssemblyName>
    <RootNamespace>Pilot.Node</RootNamespace>
    <!-- One native binary per machine. PublishAot also turns on the Request Delegate Generator for the Map* calls
         here and the trim/AOT analyzers, but their IL2xxx/IL3xxx warnings only show on a publish with -r <rid>:
         publish to check an endpoint change, building is not enough. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- DXGI's COM calls are made through function pointers on the vtable (MachineNative), as AOT generates no COM marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- Workstation concurrent GC, not server GC (#794). The Web SDK turns server GC on, which gives each of the 16
         cores its own heap and lets every heap grow before it collects. On 2026-11-07 the node (beta 1781) was at
         4.8 GB minutes after a restart and 5.56 GB a few minutes later, on a 64 GB machine at 100% CPU; a dump that
         morning read 2.5 GB working set = 1.08 GB live + 1.21 GB LOH (477 MB of it fragmentation) + 737 MB pinned,
         with System.GC.Server true (16 heaps). A node is one process serving a handful of clients: one heap that
         collects in the background keeps it small and leaves the cores to the builds. The property is
         ServerGarbageCollection (ServerGarbageCollector is silently ignored); bin's pilot-node.runtimeconfig.json
         must read "System.GC.Server": false, which PinnedHeapTests checks. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pilot.Contracts\Pilot.Contracts.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- The UI face, the one file Pilot.Gui ships: the design check and render draw with it, as the Designs page plays with it (PIL1096). -->
  <ItemGroup>
    <Content Include="..\Pilot.Gui\Fonts\DejaVuSans.ttf" Link="Fonts\DejaVuSans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Pilot.Gui\Fonts\DejaVuSans.LICENSE.txt" Link="Fonts\DejaVuSans.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The monospace face the cell grids are drawn in (PIL1098), shipped by Pilot.Gui beside the UI face. -->
  <ItemGroup>
    <Content Include="..\Pilot.Gui\Fonts\DejaVuSansMono.ttf" Link="Fonts\DejaVuSansMono.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Pilot.Gui\Fonts\DejaVuSansMono.LICENSE.txt" Link="Fonts\DejaVuSansMono.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The cell arrange, paint and grid code the GUI and pilot-tui share (PIL1098): the node builds with the same file, so a check at 80x24 is the screen pilot-tui plays. -->
  <ItemGroup>
    <Compile Include="..\Pilot.Ui\PrototypeCells.cs" Link="Designs\PrototypeCells.cs" />
  </ItemGroup>

  <!-- The Claude Code skills the node installs for every session on the machine (UserSkills.cs), in the binary: a native
       release carries no file beside it. Named UserSkills/<skill>/<path>. -->
  <ItemGroup>
    <EmbeddedResource Include="UserSkills\**\*" LogicalName="UserSkills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    LAN.Lib (discovery, invites, grants) from the sibling clone when it is there, as the GUI takes DIR.Lib: see the
    GUI's project for SharpAstroRoot's two probes and why a publish with a runtime identifier takes the package.
  -->
  <PropertyGroup>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\LAN.Lib')">$(MSBuildThisFileDirectory)..\..\..\</SharpAstroRoot>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND '$(UseLocalSiblings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\..\LAN.Lib')">$(MSBuildThisFileDirectory)..\..\..\..\..\..\</SharpAstroRoot>
    <UseLocalLanLib Condition="'$(UseLocalLanLib)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)LAN.Lib\src\LAN.Lib\LAN.Lib.csproj')">true</UseLocalLanLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalLanLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)LAN.Lib\src\LAN.Lib\LAN.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLanLib)' != 'true'">
    <PackageReference Include="LAN.Lib" />
  </ItemGroup>

  <!-- Console.Lib's cell layout and wireframe rules (PIL1098), taken as Pilot.Tui takes it, after SharpAstroRoot is set above. -->
  <PropertyGroup>
    <UseLocalConsoleLib Condition="'$(UseLocalConsoleLib)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)Console.Lib\src\Console.Lib\Console.Lib.csproj')">true</UseLocalConsoleLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)Console.Lib\src\Console.Lib\Console.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' != 'true'">
    <PackageReference Include="Console.Lib" Condition="'$(Configuration)' != 'Debug'" />
    <PackageReference Include="Console.Lib.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- DIR.Lib's Prototype (DIR249): the node loads, checks and renders a design's prototype itself, so publish re-runs the check
       rather than trusting a file. Taken as Pilot.Ui takes it: the sibling clone's source when it is there, else the package
       (DIR.Lib.Debug in Debug), so one DIR.Lib is in the graph. The prototype reader and the renderers are reflection free. -->
  <PropertyGroup>
    <UseLocalDirLib Condition="'$(UseLocalDirLib)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)DIR.Lib\src\DIR.Lib\DIR.Lib.csproj')">true</UseLocalDirLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' != 'true'">
    <PackageReference Include="DIR.Lib" Condition="'$(Configuration)' != 'Debug'" />
    <PackageReference Include="DIR.Lib.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- The PNG encoder for a design's renders, taken as Pilot.Commands takes it. -->
  <PropertyGroup>
    <UseLocalSharpAstroPng Condition="'$(UseLocalSharpAstroPng)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)Codecs\src\SharpAstro.Png\SharpAstro.Png.csproj')">true</UseLocalSharpAstroPng>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroPng)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)Codecs\src\SharpAstro.Png\SharpAstro.Png.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroPng)' != 'true'">
    <PackageReference Include="SharpAstro.Png" />
  </ItemGroup>

  <!-- AppShell's DesktopNotification and AppIdentity (PIL1384): the node's toasts, taken as Pilot.Gui takes AppShell, after SharpAstroRoot is set above. -->
  <PropertyGroup>
    <UseLocalAppShell Condition="'$(UseLocalAppShell)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)AppShell\src\SharpAstro.AppShell\SharpAstro.AppShell.csproj')">true</UseLocalAppShell>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalAppShell)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)AppShell\src\SharpAstro.AppShell\SharpAstro.AppShell.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalAppShell)' != 'true'">
    <PackageReference Include="SharpAstro.AppShell" />
  </ItemGroup>

  <!-- The lock and Kestrel on the socket (SharpAstro/Node.Lib.Hosting), by the same switch as Pilot.Contracts' Node.Lib. -->
  <PropertyGroup>
    <UseLocalNodeLib Condition="'$(UseLocalNodeLib)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)Node.Lib\src\Node.Lib.Hosting\Node.Lib.Hosting.csproj')">true</UseLocalNodeLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalNodeLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)Node.Lib\src\Node.Lib.Hosting\Node.Lib.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalNodeLib)' != 'true'">
    <PackageReference Include="Node.Lib.Hosting" />
  </ItemGroup>

  <!-- Written global::, so Node.Lib never resolves as Pilot.Node.Lib inside this namespace. -->
  <ItemGroup>
    <Using Include="Node.Lib" />
    <Using Include="Node.Lib.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pilot.Node.Tests" />
  </ItemGroup>

</Project>
