<Project>

  <PropertyGroup>
    <!-- THE version of pilot v2, and the only place it is written. CI reads it back
         (dotnet msbuild -getProperty:VersionMajorMinor) and appends the run number, so a release bump
         is this one line: 2.0 -> 2.1 additive, 2.x -> 3.x breaking. v1 (pilot.py) is the 1.x line. -->
    <VersionMajorMinor>2.0</VersionMajorMinor>
    <!-- Local builds get Major.Minor.0; CI passes -p:Version=Major.Minor.<run><attempt>+<sha>, and
         the condition lets it win. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">$(VersionMajorMinor).0</VersionPrefix>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ship the /// comments in the package so consumers get IntelliSense. Keyed on the name
         rather than IsPackable, which test projects set in their own csproj, after this file is
         read. CS1591 (public member without a comment) and CS1573 (a parameter without a
         <param> when its siblings have one) are silenced: the point is to ship the docs that
         exist, not to demand them everywhere. Broken crefs and paramrefs still warn. -->
    <GenerateDocumentationFile Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <TreatWarningsAsErrors Condition="'$(GITHUB_ACTIONS)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
    <CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>true</CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>
    <CreateHardLinksForCopyAdditionalFilesIfPossible>true</CreateHardLinksForCopyAdditionalFilesIfPossible>
    <CreateHardLinksForAdditionalFilesIfPossible>true</CreateHardLinksForAdditionalFilesIfPossible>
    <CreateHardLinksForPublishFilesIfPossible>true</CreateHardLinksForPublishFilesIfPossible>
  </PropertyGroup>

  <!--
    One switch for every sibling library, as tianwen's: -p:UseLocalSiblings=false builds (or publishes) on the published
    packages, -p:UseLocalSiblings=true on the sibling clones. Unset, each UseLocal* below still self-enables when its
    clone exists (the projects' own Exists() conditions), and a single one given on the command line wins over this.
    Set here, before the project files, so their `== ''` conditions see it. Command-line properties reach every project
    in the build alike, so the choice is the same everywhere: no RuntimeIdentifier in it, which a publish's referenced
    libraries do not see, and which made a `publish -r` mix a package with its sibling's source (CS1704).
  -->
  <PropertyGroup Condition="'$(UseLocalSiblings)' != ''">
    <UseLocalDirLib Condition="'$(UseLocalDirLib)' == ''">$(UseLocalSiblings)</UseLocalDirLib>
    <UseLocalSdlVulkanRenderer Condition="'$(UseLocalSdlVulkanRenderer)' == ''">$(UseLocalSiblings)</UseLocalSdlVulkanRenderer>
    <UseLocalAppShell Condition="'$(UseLocalAppShell)' == ''">$(UseLocalSiblings)</UseLocalAppShell>
    <UseLocalSharpAstroPng Condition="'$(UseLocalSharpAstroPng)' == ''">$(UseLocalSiblings)</UseLocalSharpAstroPng>
    <UseLocalConsoleLib Condition="'$(UseLocalConsoleLib)' == ''">$(UseLocalSiblings)</UseLocalConsoleLib>
    <UseLocalLanLib Condition="'$(UseLocalLanLib)' == ''">$(UseLocalSiblings)</UseLocalLanLib>
    <UseLocalNodeLib Condition="'$(UseLocalNodeLib)' == ''">$(UseLocalSiblings)</UseLocalNodeLib>
  </PropertyGroup>

</Project>
