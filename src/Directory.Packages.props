<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The SharpAstro stack floats within a minor, as tianwen pins it: CI publishes each run as a new patch. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
  <!-- An opt-in local build cache (docs/build-cache.md): present only under -p:MSBuildCacheEnabled=true, so a plain build,
       a restore and CI never see these packages. Both ride one version; the reference itself is in Directory.Build.props. -->
  <ItemGroup Condition="'$(MSBuildCacheEnabled)' == 'true'">
    <PackageVersion Include="Microsoft.MSBuildCache.Local" Version="0.1.340-preview" />
    <PackageVersion Include="Microsoft.MSBuildCache.SharedCompilation" Version="0.1.340-preview" />
  </ItemGroup>
  <!-- The command lines of pilot, pilot-node and pilot-gui, as tianwen's CLI parses its own (the same version). -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
  <!-- The GUI's logging, as tianwen's GUI logs (the same version): its own logger, and the renderer's (SdlVulkanLog). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <!-- Each .Debug twin (taken in place of its Release package when Configuration is Debug, because only the twin carries
       the debug inspector) must stay on its Release package's pin, or two DIR.Lib builds meet in one graph. -->
  <!-- Pilot.Gui: the SharpAstro stack. A local build compiles the sibling clones instead (the UseLocal* switches in
       Pilot.Gui.csproj); these are what CI restores. -->
  <ItemGroup>
    <!-- The SharpAstro pins below are exact, each for the release that first brought a feature this repo uses:
         - Console.Lib 5.38.3031: built against DIR.Lib 11.98; it keeps CON84 (EmptyRows skips a declared border row).
         - DIR.Lib and DIR.Lib.Debug 11.106.10471: what SdlVulkan.Renderer 7.122 builds against (11.103) and since. It keeps 11.95's broken or ellipsised word
           with its whole text on hover (SharpAstro/DIR.Lib#275), 11.94's wrapping toast buttons (SharpAstro/DIR.Lib#318), 11.91's icon controls
           (SharpAstro/DIR.Lib#290), #282 (toasts at the bottom right, a surface taking the pointer from what it covers) and the DIR_INSPECTOR opt-in in Release builds.
         - SdlVulkan.Renderer and SdlVulkan.Renderer.Debug 7.122.6201: the window rests while nothing is owed (7.110: the redraw check paced to the refresh,
           IdleCheckInterval and Wake), a generation-0 collection between frames (7.115: BetweenFramesCollector) and frame damage (AddFrameDamage), which
           pilot-gui's frame schedule uses (pilot #1443). It keeps 7.106's caret blink handover (SharpAstro/.github#13) and 7.107's GPU Y'CbCr conversion. -->
    <PackageVersion Include="Console.Lib" Version="5.38.3031" />
    <PackageVersion Include="Console.Lib.Debug" Version="5.38.3031" />
    <PackageVersion Include="DIR.Lib" Version="11.106.10471" />
    <PackageVersion Include="DIR.Lib.Debug" Version="11.106.10471" />
    <PackageVersion Include="LAN.Lib" Version="2.4.*" />
    <!-- The per-user node's socket location, lock, Kestrel hosting, event queue and ring buffer (SharpAstro/Node.Lib), shared with tianwen. -->
    <PackageVersion Include="Node.Lib" Version="1.2.*" />
    <PackageVersion Include="Node.Lib.Hosting" Version="1.2.*" />
    <PackageVersion Include="SdlVulkan.Renderer" Version="7.122.6201" />
    <PackageVersion Include="SdlVulkan.Renderer.Debug" Version="7.122.6201" />
    <PackageVersion Include="SharpAstro.AppShell" Version="1.7.*" />
    <PackageVersion Include="SharpAstro.Png" Version="3.41.*" />
    <PackageVersion Include="SharpAstro.Jpeg" Version="3.41.*" />
    <PackageVersion Include="SharpAstro.Webp" Version="3.41.*" />
    <PackageVersion Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
    <PackageVersion Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
  </ItemGroup>
</Project>
