<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The SharpAstro stack floats within a minor, as tianwen pins it: CI publishes each run as a new patch. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
  <!-- The command lines of pilot, pilot-node and pilot-gui, as tianwen's CLI parses its own (the same version). -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
  <!-- The GUI's logging, as tianwen's GUI logs (the same version): its own logger, and the renderer's (SdlVulkanLog). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>
  <!-- Pilot.Gui: the SharpAstro stack. A local build compiles the sibling clones instead (the UseLocal* switches in
       Pilot.Gui.csproj); these are what CI restores. -->
  <ItemGroup>
    <PackageVersion Include="DIR.Lib" Version="11.37.*" />
    <PackageVersion Include="Console.Lib" Version="5.11.*" />
    <PackageVersion Include="LAN.Lib" Version="2.4.*" />
    <!-- The per-user node's socket location, lock, Kestrel hosting, event queue and ring buffer (SharpAstro/Node.Lib), shared with tianwen. -->
    <PackageVersion Include="Node.Lib" Version="1.2.*" />
    <PackageVersion Include="Node.Lib.Hosting" Version="1.2.*" />
    <PackageVersion Include="SdlVulkan.Renderer" Version="7.74.*" />
    <PackageVersion Include="SharpAstro.AppShell" Version="1.2.*" />
    <PackageVersion Include="SharpAstro.Png" Version="3.23.*" />
    <PackageVersion Include="SharpAstro.Jpeg" Version="3.23.*" />
    <PackageVersion Include="SharpAstro.Webp" Version="3.23.*" />
    <PackageVersion Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
    <PackageVersion Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
  </ItemGroup>
</Project>
