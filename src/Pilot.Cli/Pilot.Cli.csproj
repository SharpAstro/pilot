<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pilot</AssemblyName>
    <RootNamespace>Pilot.Cli</RootNamespace>
    <!-- One native binary, as the node is: workers run it on every step, so it starts in milliseconds. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The command tree is Pilot.Commands', shared with the GUI's command bar; this is its console host. -->
    <ProjectReference Include="..\Pilot.Commands\Pilot.Commands.csproj" />
  </ItemGroup>

</Project>
