<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pilot</AssemblyName>
    <RootNamespace>Pilot.Cli</RootNamespace>
    <!-- One native binary, as the node is: workers run it on every step, so it starts in milliseconds. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The command tree is Pilot.Commands', shared with the GUI's Connect; this is its console host. -->
    <ProjectReference Include="..\Pilot.Commands\Pilot.Commands.csproj" />
  </ItemGroup>

  <!-- Console.Lib's MarkdownOutput for the output-format option: status rendered as mdcat renders it, on a terminal that
       shows Sixel. Only this host takes it (see Pilot.Commands' RichOutput). From the sibling clone when it is there. -->
  <PropertyGroup>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\Console.Lib')">$(MSBuildThisFileDirectory)..\..\..\</SharpAstroRoot>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\..\Console.Lib')">$(MSBuildThisFileDirectory)..\..\..\..\..\..\</SharpAstroRoot>
    <UseLocalConsoleLib Condition="'$(UseLocalConsoleLib)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)Console.Lib\src\Console.Lib\Console.Lib.csproj')">true</UseLocalConsoleLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)Console.Lib\src\Console.Lib\Console.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' != 'true'">
    <PackageReference Include="Console.Lib" Condition="'$(Configuration)' != 'Debug'" />
    <PackageReference Include="Console.Lib.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
