<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!-- Pilot.Gui brings the sample snapshot and the font with it (its Content), so the CPU render here draws what
       the capture draws. -->
  <ItemGroup>
    <ProjectReference Include="..\Pilot.Gui\Pilot.Gui.csproj" />
    <ProjectReference Include="..\Pilot.Ui\Pilot.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Pilot.Ui" />
  </ItemGroup>

  <!-- Console.Lib, to arrange the shared trees in cells as pilot-tui does: from the sibling clone when it is there. -->
  <PropertyGroup>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\Console.Lib')">$(MSBuildThisFileDirectory)..\..\..\</SharpAstroRoot>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\..\Console.Lib')">$(MSBuildThisFileDirectory)..\..\..\..\..\..\</SharpAstroRoot>
    <UseLocalConsoleLib Condition="'$(UseLocalConsoleLib)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)Console.Lib\src\Console.Lib\Console.Lib.csproj')">true</UseLocalConsoleLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)Console.Lib\src\Console.Lib\Console.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalConsoleLib)' != 'true'">
    <PackageReference Include="Console.Lib" Condition="'$(Configuration)' != 'Debug'" />
    <PackageReference Include="Console.Lib.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
