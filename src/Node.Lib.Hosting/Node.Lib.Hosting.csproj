<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Node.Lib's node side: Kestrel on the socket its lock admits it to. Apart from Node.Lib so a client never
         carries ASP.NET. -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Node.Lib.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Node.Lib\Node.Lib.csproj" />
  </ItemGroup>

</Project>
