<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The pilot command tree, on System.CommandLine: one surface for the CLI (pilot), the GUI's command bar and,
         later, an MCP server (#70), so a new verb reaches all of them at once. AOT-published inside each host. -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Pilot.Commands</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pilot.Contracts\Pilot.Contracts.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- LAN.Lib for pilot nodes (listening for the nodes' beacon): from the sibling clone when it is there, as the node takes it. -->
  <PropertyGroup>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\LAN.Lib')">$(MSBuildThisFileDirectory)..\..\..\</SharpAstroRoot>
    <SharpAstroRoot Condition="'$(SharpAstroRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\..\LAN.Lib')">$(MSBuildThisFileDirectory)..\..\..\..\..\..\</SharpAstroRoot>
    <UseLocalLanLib Condition="'$(UseLocalLanLib)' == '' AND '$(SharpAstroRoot)' != '' AND Exists('$(SharpAstroRoot)LAN.Lib\src\LAN.Lib\LAN.Lib.csproj')">true</UseLocalLanLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalLanLib)' == 'true'">
    <ProjectReference Include="$(SharpAstroRoot)LAN.Lib\src\LAN.Lib\LAN.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLanLib)' != 'true'">
    <PackageReference Include="LAN.Lib" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pilot.Node.Tests" />
    <InternalsVisibleTo Include="Pilot.Gui.Tests" />
  </ItemGroup>

</Project>
