<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The pilot command tree, on System.CommandLine: one surface for the CLI (pilot), the GUI's command bar and,
         later, an MCP server (#70), so a new verb reaches all of them at once. AOT-published inside each host. -->
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Pilot.Commands</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pilot.Contracts\Pilot.Contracts.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pilot.Node.Tests" />
    <InternalsVisibleTo Include="Pilot.Gui.Tests" />
  </ItemGroup>

</Project>
