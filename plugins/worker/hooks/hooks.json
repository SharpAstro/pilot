{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/../../pilot.py\" hook-budget" },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit.sh\" big_read_guard.sh" },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit.sh\" agent_token_budget.sh" },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit.sh\" agent_call_budget.sh" }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit.sh\" agent_ratelimit_gate.sh" }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit.sh\" handback_report_gate.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit.sh\" fat_result_notice.sh" }
        ]
      }
    ]
  }
}
